# Copy to .env and fill in. The demo makes real OpenAI calls.
OPENAI_API_KEY=sk-...

# gpt-4o-mini is the right default: cheap enough to run an exhibit 20 times,
# and weak enough that bad tool design actually breaks it. A frontier model
# papers over exhibits 1, 3 and 6 through sheer competence -- which is its own
# lesson, but a worse demo.
OPENAI_MODEL=gpt-5
